// Chain-rule fieldgradient of a Landau AreaIntegral.

import meshtools

var N = 1000
var rho = 1.3
var a2 = 1-rho
var a4 = (1+rho)/rho^2

var m = AreaMesh(fn (u,v) [u, v, 0], 0..1:0.1, 0..1:0.1)
m.addgrade(1)
var q = Field(m, fn (x,y,z) Matrix([0.01*random(1), 0.01*random(1)]))

fn landau(x, qv) {
    var qt2 = qv.inner(qv)
    return a2*qt2 + a4*qt2*qt2
}

var E = AreaIntegral(landau, q, method={})
var fg
for (i in 1..N) fg = E.fieldgradient(q, m)
print fg.linearize().norm()
