// LineIntegral fieldgradient of an integrand that calls grad().

import meshtools

var N = 130
var L = 4
var dx = 0.05

var m = LineMesh(fn (t) [t, 0, 0], -L..L:dx)

fn p0(x,y,z) {
    if (x < 0) return Matrix([0, 0, 0])
    if (x > 0) return Matrix([1, 0, 0])
    return Matrix([1/2, 0, 0])
}
var P = Field(m, p0, finiteelementspace=FiniteElementSpace("CG1", grade=1))

fn gradsqp(x, p) {
    var gp = grad(p)
    return gp[0].norm()^2 + gp[1].norm()^2 + gp[2].norm()^2
}

var E = LineIntegral(gradsqp, P, method={})
var fg
for (i in 1..N) fg = E.fieldgradient(P, m)
print fg.linearize().norm()
