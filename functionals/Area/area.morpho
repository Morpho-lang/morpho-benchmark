// Area.gradient on a refined cube. Cheap geometry map.

import meshtools

var N = 24000
var nrefine = 3

var m = PolyhedronMesh([[-0.5, -0.5, -0.5],
                        [ 0.5, -0.5, -0.5],
                        [-0.5,  0.5, -0.5],
                        [ 0.5,  0.5, -0.5],
                        [-0.5, -0.5,  0.5],
                        [ 0.5, -0.5,  0.5],
                        [-0.5,  0.5,  0.5],
                        [ 0.5,  0.5,  0.5]],
                       [[0,1,3,2], [4,5,7,6],
                        [0,1,5,4], [3,2,6,7],
                        [0,2,6,4], [1,3,7,5]])

for (i in 1..nrefine) {
    var refmap = MeshRefiner([m]).refine()
    m = refmap[m]
}

var la = Area()
var g
for (i in 1..N) g = la.gradient(m)
print g.norm()
