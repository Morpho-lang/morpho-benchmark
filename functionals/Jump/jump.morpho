// Jump(jumpdn(q)^2).gradient on interior edges.

import meshtools

var N = 80
var L = 1
var delta = 0.05

var m = AreaMesh(fn (u,v) [u, v, 0], -L/2..L/2:delta, -L/2..L/2:delta)
m.addgrade(1)
var phi = Field(m, fn (x,y,z) x*y)

var j = Jump(fn (x, q) jumpdn(q)^2, phi, method={ "strategy": "centroid" })
var g
for (i in 1..N) g = j.gradient(m)
print g.norm()
