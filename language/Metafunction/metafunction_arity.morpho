// Call a meta function


fn f() { return 0 }

fn f(x) { return 1 }

fn f(x,y) { return 2 }

fn f(x,y,z) { return 3 }

fn g(x) { return 1 }

var a = "Hello"

var n = 10000000

var start = System.clock()
for (i in 1..n) {
    g(1)
    g(2.0)
    g(a)
}
var end = System.clock()

print "Regular function ${end-start}"

var start = System.clock()
for (i in 1..n) {
    f(1)
    f(2.0)
    f(a)
}
var end = System.clock()

print "Metafunction ${end-start}"
