// Hashtable of k-nucleotide counts. Sequence THREE is generated with the
// fasta PRNG (same seed, after the IUB draws) so the runner can pass N.
// Morpho has substring and Dictionary, but no toupper and no string <.

var IM = 139968
var IA = 3877
var IC = 29573
var seed = 42

var HOMO_P = [
  0.3029549426680,
  0.1979883004921,
  0.1975473066391,
  0.3015094502008
]
var HOMO = "ACGT"

fn fasta_rand(maxv) {
  seed = mod(seed * IA + IC, IM)
  return maxv * seed / IM
}

fn make_three(n) {
  for (var i = 0; i < n * 3; i += 1) {
    fasta_rand(1.0)
  }
  var chunks = []
  var b = ""
  for (var i = 0; i < n * 5; i += 1) {
    var v = fasta_rand(1.0)
    var j = 0
    for (var k = 0; k < 4; k += 1) {
      v -= HOMO_P[k]
      j = k
      if (v < 0) break
    }
    b += HOMO[j]
    if (b.count() == 4096) {
      chunks.append(b)
      b = ""
    }
  }
  if (b.count() > 0) chunks.append(b)
  var seq = ""
  for (c in chunks) seq += c
  return seq
}

fn chcode(c) {
  if (c == "A") return 0
  if (c == "C") return 1
  if (c == "G") return 2
  return 3
}

fn cmpdna(a, b) {
  var n = a.count()
  var i = 0
  while (i < n) {
    var d = chcode(a[i]) - chcode(b[i])
    if (d != 0) return d
    i += 1
  }
  return 0
}

fn gen_freq(seq, frame) {
  var frequences = Dictionary()
  var ns = seq.count() + 1 - frame
  for (var ii = 0; ii < ns; ii += 1) {
    var nucleo = seq.substring(ii, ii + frame)
    if (frequences.contains(nucleo)) {
      frequences[nucleo] = frequences[nucleo] + 1
    } else {
      frequences[nucleo] = 1
    }
  }
  return [ns, frequences]
}

fn sort_seq(seq, length) {
  var pair = gen_freq(seq, length)
  var n = pair[0]
  var frequences = pair[1]
  var rows = []
  for (k in frequences) {
    rows.append([k, frequences[k]])
  }
  rows.sort(fn (a, b) {
    var fa = a[1]
    var fb = b[1]
    if (fa > fb) return -1
    if (fa < fb) return 1
    return cmpdna(a[0], b[0])
  })
  for (row in rows) {
    print "${row[0]} ${(100.0 * row[1] / n).format("%.3f")}"
  }
  print ""
}

fn find_seq(seq, s) {
  var pair = gen_freq(seq, s.count())
  var t = pair[1]
  var c = 0
  if (t.contains(s)) c = t[s]
  print "${c}\t${s}"
}

fn main(n) {
  var sequence = make_three(n)
  sort_seq(sequence, 1)
  sort_seq(sequence, 2)
  find_seq(sequence, "GGT")
  find_seq(sequence, "GGTA")
  find_seq(sequence, "GGTATT")
  find_seq(sequence, "GGTATTTTAATT")
  find_seq(sequence, "GGTATTTTAATTTATAGT")
}

var N = 1000
var args = System.arguments()
if (args.count() > 0) N = Int(args[0])
main(N)
