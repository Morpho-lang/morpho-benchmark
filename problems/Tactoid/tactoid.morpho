// Coupled mesh + director tactoid (optimize4 SQP).
// Requires: morphopm install optimize4

import meshtools
import meshgen
import optimize4

var W = 100

var dom = CircularDomain([0, 0], 1)
var mg = MeshGen(dom, [-1..1:0.1, -1..1:0.1], quiet=true)
var m = ChangeMeshDimension(mg.build(), 3)
m.addgrade(1)
var n = Field(m, Matrix([1, 0, 0]))
var bnd = Selection(m, boundary=true)

var problem = OptimizationProblem(m)
problem.addEnergy(Nematic(n))
problem.addEnergy(Length(), selection=bnd, prefactor=10)
problem.addEnergy(LineIntegral(fn (x, nn) (tangent().inner(nn))^2, n),
    selection=bnd, prefactor=-5)
problem.addEnergy(EquiElement(), prefactor=0.1)
problem.addConstraint(Area())
problem.addLocalConstraint(NormSq(n), target=1)

var opt = SQPController(ProblemAdapter(problem, m, n), verbosity="silent")
var conv = opt.optimize(W)
print conv
print Nematic(n).total(m)
print Area().total(m)
