// Area at fixed enclosed volume (optimize4 PGD).
// Refine first, then relax. Distinct from Cube/, which uses SQP.
// Requires: morphopm install optimize4

import meshtools
import optimize4

var nrefine = 5
var Nsteps = 80

var m = Mesh("cube.mesh")
for (i in 1..nrefine) {
  var refmap = MeshRefiner([m]).refine()
  m = refmap[m]
}

var problem = OptimizationProblem(m)
problem.addEnergy(Area())
problem.addConstraint(VolumeEnclosed())
var opt = ProjectedGradientDescentController(ProblemAdapter(problem, m),
                                             verbosity="silent", mu=100)
opt._reprojectquiet = true
opt.optimize(Nsteps)

var lv = VolumeEnclosed()
var la = Area()
var V0 = lv.total(m)
var Af = la.total(m)
var R = (V0/(4/3*Pi))^(1/3)
var area = 4*Pi*R^2
print "Final area: ${Af} True area: ${area} diff: ${abs(Af-area)}"
